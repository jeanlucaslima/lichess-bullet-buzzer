{
  "manifest_version": 3,
  "name": "Lichess Bullet Buzzer",
  "version": "0.2.1",
  "description": "Beeps at 1s, 2s, and 3s on your turn to train bullet response time.",
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "beep1.wav",
        "beep2.wav",
        "beep3.wav",
        "end.wav"
      ],
      "matches": [
        "https://lichess.org/*"
      ]
    }
  ]
}
